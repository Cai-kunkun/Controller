<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Material 3 with dynamic color (Material You) + DayNight -->
    <style name="Theme.Controller" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
    </style>

    <!-- Expressive pill-shaped text fields -->
    <style name="Widget.Controller.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">28dp</item>
        <item name="boxCornerRadiusTopEnd">28dp</item>
        <item name="boxCornerRadiusBottomStart">28dp</item>
        <item name="boxCornerRadiusBottomEnd">28dp</item>
    </style>

    <!-- Expressive chat bubble shapes -->
    <style name="ShapeAppearanceOverlay.Bubble.User" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">24dp</item>
        <item name="cornerSizeBottomRight">6dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.Bubble.Assistant" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">6dp</item>
        <item name="cornerSizeBottomRight">24dp</item>
    </style>

</resources>
